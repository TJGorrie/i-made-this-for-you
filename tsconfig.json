{
  "compilerOptions": {
    "target": "es2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "lib": ["es2023", "dom"],
    "types": ["node", "vite/client"]
  },
  "include": ["src", "server", "scripts", "tests", "vite.config.ts", "playwright.config.ts"]
}
